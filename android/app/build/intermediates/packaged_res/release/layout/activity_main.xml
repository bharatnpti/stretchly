<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Stretchly!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/preferencesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Preferences"
            android:background="@color/primary_color"
            android:textColor="@android:color/white"
            android:padding="16dp" />

        <Button
            android:id="@+id/insightsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Insights &amp; Analytics"
            android:background="@color/secondary_color"
            android:textColor="@android:color/white"
            android:padding="16dp" />

        <Button
            android:id="@+id/badgesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Streaks &amp; Badges"
            android:background="@color/accent_color"
            android:textColor="@android:color/white"
            android:padding="16dp" />

        <Button
            android:id="@+id/goalModesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Goal Modes"
            android:background="@color/primary_color"
            android:textColor="@android:color/white"
            android:padding="16dp" />

        <Button
            android:id="@+id/contentPacksButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Content Packs"
            android:background="@color/secondary_color"
            android:textColor="@android:color/white"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>
