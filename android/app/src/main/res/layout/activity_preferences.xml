<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".PreferencesActivity">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/microbreakSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Mini Breaks" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/breakSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Long Breaks" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Microbreak interval (minutes)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/microbreakIntervalInput"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Microbreak duration (seconds)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/microbreakDurationInput"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Break interval (minutes)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/breakIntervalInput"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Break duration (seconds)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/breakDurationInput"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
