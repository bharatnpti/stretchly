<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.hovancik.stretchly">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".StretchlyApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".MicrobreakActivity" />
        <activity android:name=".BreakActivity" />
        <activity android:name=".GuidedMicrobreakActivity" />
        <activity android:name=".PreferencesActivity" />
        <activity android:name=".InsightsActivity" />
        <activity android:name=".BadgesActivity" />
        <activity android:name=".GoalModesActivity" />
        <activity android:name=".EditGoalModeActivity" />
        <activity android:name=".ContentPacksActivity" />
        
        <service
            android:name=".BreakSchedulerService"
            android:foregroundServiceType="dataSync" />

        <receiver android:name=".AutostartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
